		../../debug/moc_predefs.h \
		/usr/lib/qt6/moc
	/usr/lib/qt6/moc $(DEFINES) --include /home/L2B-Z_O/MIRI-FIB/FRR/ViewerPBS25-students/debug/moc_predefs.h -I/usr/lib/qt6/mkspecs/linux-g++ -I/home/L2B-Z_O/MIRI-FIB/FRR/ViewerPBS25-students -I/usr/include/qt6 -I/usr/include/qt6/QtOpenGLWidgets -I/usr/include/qt6/QtOpenGL -I/usr/include/qt6/QtWidgets -I/usr/include/qt6/QtGui -I/usr/include/qt6/QtCore -I. -I/usr/include/c++/14.2.1 -I/usr/include/c++/14.2.1/x86_64-pc-linux-gnu -I/usr/include/c++/14.2.1/backward -I/usr/lib/gcc/x86_64-pc-linux-gnu/14.2.1/include -I/usr/local/include -I/usr/lib/gcc/x86_64-pc-linux-gnu/14.2.1/include-fixed -I/usr/include ../../main_window.h -o ../../debug/moc_main_window.cpp

../../debug/moc_glwidget.cpp: ../../glwidget.h \
		../../camera.h \
		../../triangle_mesh.h \
		../../debug/moc_predefs.h \
